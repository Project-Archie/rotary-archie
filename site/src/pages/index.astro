  <script is:inline>
  (() => {
    const root = document.documentElement;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    // Picker (UX review 2026-11-18). Phone (under 720px): the steps open directly under the tapped choice, and the page starts
    // with all five choices closed so the reader sees every option. From 720px: choices left, the open panel right, Claude open.
    // After every pick the result is kept on screen: on a phone the tapped choice sits just under the bar; wider, the panel does.
    const pick = document.querySelector('.pick');
    const radios = pick ? [...pick.querySelectorAll('input[name=assistant]')] : [];
    const narrow = matchMedia('(max-width: 719px)');
    if (narrow.matches) radios.forEach((r) => { r.checked = false; });
    narrow.addEventListener('change', (e) => { if (!e.matches && !radios.some((r) => r.checked)) radios[0].checked = true; });
    const barBottom = () => document.querySelector('.bar').getBoundingClientRect().bottom;
    const keepInView = (r, always) => {
      const panel = document.getElementById(r.getAttribute('aria-controls'));
      const target = narrow.matches ? r.closest('.choice') : panel;
      const top = target.getBoundingClientRect().top, first = panel.querySelector('ol li');
      const hidden = top < barBottom() + 8 || (first && first.getBoundingClientRect().bottom > innerHeight);
      if (always || hidden) scrollBy(0, top - barBottom() - 12);
    };
    // click, not change: tapping the choice that is already open still brings its steps into view (arrow keys fire click too).
    radios.forEach((r) => r.addEventListener('click', () => keepInView(r, false)));
    // A link to a picker choice selects it and brings it into view; without JavaScript it still lands on the picker (#get).
    document.querySelectorAll('a[data-pick]').forEach((a) => a.addEventListener('click', (e) => {
      const r = document.getElementById(a.dataset.pick); if (!r) return;
      e.preventDefault(); r.checked = true; keepInView(r, true); r.focus({ preventScroll: true });
    }));
    if (reduce || !('IntersectionObserver' in window)) return;
    // Attention devices: once per load, at 60 percent in view, loudest only (spotlight over highlight).
    const marks = [...document.querySelectorAll('.hl[data-sweep]')];
    const counter = document.querySelector('[data-count]');
    marks.forEach((m) => m.classList.add('wait'));
    const runCount = (el) => {
      const from = +el.dataset.count, to = +el.textContent, t0 = performance.now(), dur = 960;
      const ease = (t) => (t < .5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2);
      el.textContent = from;
      const step = (now) => { const t = Math.min(1, (now - t0) / dur); el.textContent = Math.round(from + (to - from) * ease(t)); if (t < 1) requestAnimationFrame(step); };
      requestAnimationFrame(step);
    };
    const io = new IntersectionObserver((entries) => {
      const shown = entries.filter((e) => e.isIntersecting);
      const spot = shown.find((e) => e.target === counter);
      shown.forEach((e) => {
        io.unobserve(e.target);
        if (e.target === counter) { runCount(counter); return; }
        if (spot) { e.target.classList.remove('wait'); return; }
        e.target.classList.add('run');
      });
    }, { threshold: 0.6 });
    marks.forEach((m) => io.observe(m));
    if (counter) io.observe(counter);
  })();
  </script>
</body>
</html>
